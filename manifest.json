{
  "manifest_version": 3,
  "name": "YouTube Upload Date",
  "version": "1.1",
  "description": "Shows the exact upload date and time of the current YouTube video in any timezone.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Upload Date"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}